    {
      "parameters": {
        "jsCode": "// Turns the typed number into + and digits with a country code, the format Fazz accepts.\n// A number typed with \"+\" keeps its own country code; one without gets the default.\nreturn $input.all().map((item) => {\n  const lead = item.json;\n  const typed = String(lead.phone ?? '').trim();\n  let digits = typed.replace(/\\D/g, '');\n  if (!typed.startsWith('+') && digits.length <= 11) {\n    digits = String(lead.defaultCountryCode ?? '').replace(/\\D/g, '') + digits.replace(/^0+/, '');\n  }\n  const name = String(lead.name ?? '').trim().replace(/\\s+/g, ' ');\n\n  return {\n    json: {\n      ...lead,\n      name,\n      firstName: name.split(' ')[0] || name,\n      email: String(lead.email ?? '').trim().toLowerCase(),\n      interest: String(lead.interest ?? '').trim(),\n      phoneTyped: typed,\n      phone: `+${digits}`,\n      phoneValid: digits.length >= 10 && digits.length <= 15,\n    },\n  };\n});"
      },
