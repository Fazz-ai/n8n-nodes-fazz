    {
      "parameters": {
        "jsCode": "// Prepares each row for the template: the number in international format and the date as the customer reads it.\nconst settings = $('Reminder settings').first().json;\n\nreturn $input.all().map((item) => {\n  const row = item.json;\n  const typed = String(row.phone ?? '').trim();\n  let digits = typed.replace(/\\D/g, '');\n  if (!typed.startsWith('+') && digits.length <= 11) {\n    digits = String(settings.defaultCountryCode ?? '').replace(/\\D/g, '') + digits.replace(/^0+/, '');\n  }\n  const name = String(row.customer_name ?? '').trim();\n\n  return {\n    json: {\n      ...row,\n      firstName: name.split(/\\s+/)[0] || name,\n      phoneTyped: typed,\n      phone: `+${digits}`,\n      phoneValid: digits.length >= 10 && digits.length <= 15,\n      appointmentText: DateTime.fromISO(String(row.appointment_at)).toFormat(settings.dateFormat),\n    },\n  };\n});"
      },
      "id": "13f7c804-6cf4-45bc-b2d0-a6d5790c4a43",
